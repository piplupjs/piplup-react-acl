{
  "name": "@piplup/react-acl",
  "version": "4.1.0",
  "private": false,
  "description": "Role and permission-based access control for React, with wildcard grants, a loading state and typed permission names.",
  "keywords": [
    "access control",
    "authorization",
    "permissions",
    "rbac",
    "react access control",
    "react permission based access",
    "react permissions",
    "react rbac",
    "react-acl",
    "role-based access control",
    "roles"
  ],
  "homepage": "https://www.piplupjs.com/docs/react-acl/installation",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/piplupjs/piplup-react-acl.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "node ./scripts/prepare.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --build --noEmit && tsc -p tsconfig.augment.json",
    "build": "vite build",
    "release": "tsx scripts/release.mts",
    "release:dry": "tsx scripts/release.mts --dry-run",
    "test": "vitest run"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@piplup/code-infra": "^2.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^6.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.93.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.11",
    "yargs": "^18.2.0"
  },
  "peerDependencies": {
    "@types/react": "^18.2.0 || ^19.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
